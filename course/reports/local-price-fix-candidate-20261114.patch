+package com.macro.mall.portal;
+
+import com.macro.mall.mapper.PmsProductMapper;
+import com.macro.mall.mapper.PmsSkuStockMapper;
+import com.macro.mall.model.OmsCartItem;
+import com.macro.mall.model.PmsProduct;
+import com.macro.mall.model.PmsProductFullReduction;
+import com.macro.mall.model.PmsSkuStock;
+import com.macro.mall.portal.dao.PortalProductDao;
+import com.macro.mall.portal.domain.CartPromotionItem;
+import com.macro.mall.portal.domain.PromotionProduct;
+import com.macro.mall.portal.service.impl.OmsCartItemServiceImpl;
+import com.macro.mall.portal.service.impl.OmsPromotionServiceImpl;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class LocalPriceFixTest {
+    @Test
+    void promotionAlwaysReplacesCartPriceWithSkuPrice() {
+        OmsPromotionServiceImpl service = new OmsPromotionServiceImpl();
+        CartPromotionItem item = new CartPromotionItem();
+        item.setPrice(BigDecimal.ONE);
+        PmsSkuStock sku = new PmsSkuStock();
+        sku.setPrice(new BigDecimal("12000"));
+
+        ReflectionTestUtils.invokeMethod(service, "serverPrice", item, sku);
+
+        assertEquals(new BigDecimal("12000"), item.getPrice());
+    }
+
+    @Test
+    void cartAlwaysUsesSkuPriceEvenWhenRequestHasNoPrice() {
+        PmsSkuStockMapper skuMapper = mock(PmsSkuStockMapper.class);
+        PmsProductMapper productMapper = mock(PmsProductMapper.class);
+        PmsSkuStock sku = new PmsSkuStock();
+        sku.setId(303L);
+        sku.setProductId(202L);
+        sku.setPrice(new BigDecimal("12000"));
+        PmsProduct product = new PmsProduct();
+        product.setId(202L);
+        product.setPublishStatus(1);
+        product.setDeleteStatus(0);
+        when(skuMapper.selectByPrimaryKey(303L)).thenReturn(sku);
+        when(productMapper.selectByPrimaryKey(202L)).thenReturn(product);
+        OmsCartItemServiceImpl service = new OmsCartItemServiceImpl();
+        ReflectionTestUtils.setField(service, "skuStockMapper", skuMapper);
+        ReflectionTestUtils.setField(service, "productMapper", productMapper);
+        OmsCartItem item = new OmsCartItem();
+        item.setProductId(202L);
+        item.setProductSkuId(303L);
+
+        ReflectionTestUtils.invokeMethod(service, "fillFromSku", item);
+
+        assertEquals(new BigDecimal("12000"), item.getPrice());
+    }
+
+    @Test
+    void singleItemPromotionStillUsesDiscountedPrice() {
+        PmsSkuStock sku = sku();
+        sku.setPromotionPrice(new BigDecimal("9000"));
+        PromotionProduct product = promotionProduct(1, sku);
+        CartPromotionItem result = promotion(product, cart()).get(0);
+
+        assertEquals(new BigDecimal("12000"), result.getPrice());
+        assertEquals(new BigDecimal("3000"), result.getReduceAmount());
+        assertEquals(new BigDecimal("9000"), result.getPrice().subtract(result.getReduceAmount()));
+    }
+
+    @Test
+    void fullReductionPromotionStillAllocatesDiscount() {
+        PmsSkuStock sku = sku();
+        PromotionProduct product = promotionProduct(4, sku);
+        PmsProductFullReduction reduction = new PmsProductFullReduction();
+        reduction.setFullPrice(new BigDecimal("10000"));
+        reduction.setReducePrice(new BigDecimal("2000"));
+        product.setProductFullReductionList(new ArrayList<>(List.of(reduction)));
+        CartPromotionItem result = promotion(product, cart()).get(0);
+
+        assertEquals(new BigDecimal("12000"), result.getPrice());
+        assertEquals(new BigDecimal("2000"), result.getReduceAmount());
+        assertEquals(new BigDecimal("10000"), result.getPrice().subtract(result.getReduceAmount()));
+    }
+
+    private static List<CartPromotionItem> promotion(PromotionProduct product, OmsCartItem item) {
+        PortalProductDao dao = mock(PortalProductDao.class);
+        when(dao.getPromotionProductList(List.of(202L))).thenReturn(List.of(product));
+        OmsPromotionServiceImpl service = new OmsPromotionServiceImpl();
+        ReflectionTestUtils.setField(service, "portalProductDao", dao);
+        return service.calcCartPromotion(List.of(item));
+    }
+
+    private static PromotionProduct promotionProduct(int type, PmsSkuStock sku) {
+        PromotionProduct product = new PromotionProduct();
+        product.setId(202L);
+        product.setPromotionType(type);
+        product.setSkuStockList(List.of(sku));
+        return product;
+    }
+
+    private static PmsSkuStock sku() {
+        PmsSkuStock sku = new PmsSkuStock();
+        sku.setId(303L);
+        sku.setPrice(new BigDecimal("12000"));
+        sku.setStock(10);
+        sku.setLockStock(0);
+        return sku;
+    }
+
+    private static OmsCartItem cart() {
+        OmsCartItem item = new OmsCartItem();
+        item.setProductId(202L);
+        item.setProductSkuId(303L);
+        item.setQuantity(1);
+        item.setPrice(BigDecimal.ONE);
+        return item;
+    }
+}
