# Extracted book-4 Spring modules only: common, generated models, security, portal.
FROM maven:3.9.12-eclipse-temurin-17 AS build
WORKDIR /src
COPY pom.xml ./
COPY mall-common/pom.xml mall-common/pom.xml
COPY mall-mbg/pom.xml mall-mbg/pom.xml
COPY mall-security/pom.xml mall-security/pom.xml
COPY mall-portal/pom.xml mall-portal/pom.xml
COPY . .
# secure-kit(book-4에서 만든 보안 부품, MIT)을 먼저 로컬 Maven 저장소에 설치한다
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -q -f secure-kit-spring/pom.xml install -DskipTests \
    && mvn -B -q -pl mall-portal -am package -DskipTests -Ddocker.skip=true \
    && cp mall-portal/target/mall-portal-*.jar /portal.jar

FROM eclipse-temurin:17.0.17_10-jre
RUN useradd --system --uid 10001 sre && mkdir -p /var/logs && chown sre /var/logs
USER sre
WORKDIR /app
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -Xss512k -XX:TieredStopAtLevel=1" \
    TZ=Asia/Seoul
COPY --from=build /portal.jar /app/app.jar
EXPOSE 8085
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
